---
import { type ImageMetadata } from '@/lib/images'
import { Image } from 'astro:assets'

interface Breadcrumb {
  label: string
  href: string
}

interface Action {
  label: string
  href: string
}

interface Props {
  kicker?: string
  title?: string
  subtitle?: string
  image?: {
    src: ImageMetadata
    alt: string
    position?: string
  }
  primaryAction?: Action | null
  secondaryAction?: Action | null
}

const {
  kicker = '',
  title,
  subtitle = '',
  image,
  primaryAction = null,
  secondaryAction = null,
} = Astro.props

const pagePathname = Astro.url.pathname

const normalizePath = (pathname: string): string => {
  if (!pathname || pathname === '/') return '/'

  const clean = pathname.replace(/\/+$/, '')

  return clean.startsWith('/') ? clean : `/${clean}`
}

const toRelativeHref = (pathname: string): string => {
  if (pathname === '/') return '.'

  return `${pathname.replace(/^\//, '')}/`
}

const prettifySegment = (segment: string): string =>
  segment
    .split('-')
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ')

const path = normalizePath(pagePathname)
const segments = path.split('/').filter(Boolean)

const sectionLabels: Record<string, string> = {
  kariera: 'Kariera',
  ludzie: 'Ludzie',
  technologia: 'Technologia',
  wiedza: 'Wiedza',
  zawod: 'Zawód Pilota',
}

const breadcrumbs: Breadcrumb[] =
  path === '/'
    ? []
    : [
        { label: 'Strona główna', href: '.' },
        ...segments.map((segment, index) => {
          const href = toRelativeHref(`/${segments.slice(0, index + 1).join('/')}`)
          const isLast = index === segments.length - 1

          const label = isLast
            ? (title ?? prettifySegment(segment))
            : (sectionLabels[segment] ?? prettifySegment(segment))

          return { label, href }
        }),
      ]

const resolvedTitle = title ?? prettifySegment(segments.at(-1) ?? '')
const shouldShowKicker = kicker.trim().length > 0 && breadcrumbs.length === 0

const breadcrumbStructuredData =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.label,
          item: new URL(crumb.href, Astro.url).href,
        })),
      }
    : null

const bgPosition = image?.position ?? 'center 25%'
---

<section
  class="pageHero ds-hero ds-hero--small min-h-[320px]"
  style={!image?.src ? 'background-color: var(--navy-950);' : undefined}
>
  {
    image?.src && (
      <>
        <Image
          src={image.src}
          alt=""
          aria-hidden="true"
          class="pageHero__media"
          style={`object-position: ${bgPosition};`}
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <div class="pageHero__overlay" />
      </>
    )
  }

  <div class="pageHero__content ds-container py-12 md:py-14 flex flex-col gap-4 max-w-[860px]">
    {
      breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="text-white/70 text-sm flex flex-wrap gap-2">
          {breadcrumbs.map((crumb, i) => (
            <>
              {i > 0 && (
                <span aria-hidden="true" class="opacity-50">
                  ›
                </span>
              )}

              <a
                href={crumb.href}
                class={
                  i === breadcrumbs.length - 1
                    ? 'text-white/50'
                    : 'hover:text-white/100 transition-colors'
                }
              >
                {crumb.label}
              </a>
            </>
          ))}
        </nav>
      )
    }

    {shouldShowKicker && <p class="text-white/70 text-sm uppercase tracking-wide">{kicker}</p>}

    <h1 class="ds-h1 text-white">
      {resolvedTitle}
    </h1>

    {subtitle && <p class="text-[18px] text-white/80">{subtitle}</p>}

    {
      (primaryAction || secondaryAction) && (
        <div class="flex gap-3 flex-wrap mt-2">
          {primaryAction && (
            <a href={primaryAction.href} class="ds-btn ds-btn-primary">
              {primaryAction.label}
            </a>
          )}

          {secondaryAction && (
            <a href={secondaryAction.href} class="ds-btn ds-btn-secondary">
              {secondaryAction.label}
            </a>
          )}
        </div>
      )
    }
  </div>

  {
    breadcrumbStructuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbStructuredData)}
      />
    )
  }
</section>

<style>
  .pageHero {
    position: relative;
    overflow: hidden;
  }

  .pageHero__media {
    position: absolute;
    inset: 0;

    z-index: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .pageHero__overlay {
    position: absolute;
    inset: 0;

    z-index: 1;

    /* background: rgb(0 0 0 / 0.25); */

    pointer-events: none;
  }

  .pageHero__content {
    position: relative;
    z-index: 2;
  }
</style>
