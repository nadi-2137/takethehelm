---
import type { AppImage } from '@/lib/images'
import { Image } from 'astro:assets'

interface Tab {
  label: string
  key: string
}

interface GalleryItem {
  image: AppImage
  tag: string
  caption?: string
}

interface Props {
  style?: Record<string, string>
  tabs?: Tab[]
  items?: GalleryItem[]
}

const { style, tabs = [], items = [] } = Astro.props
const defaultStyle = {
  root: 'ds-section',
  inner: 'ds-container',
  tabs: 'flex gap-2 flex-wrap mb-6',
  tab: 'ds-pill',
  grid: 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6',
  item: 'ds-surface overflow-hidden',
}
const s = { ...defaultStyle, ...(style ?? {}) }
const allKey = 'all'
const transparentPixel = 'data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA='
---

<section class={s.root}>
  <div class={s.inner}>
    {
      tabs.length > 0 && (
        <div class={s.tabs} id="gallery-tabs">
          <button
            class={`${s.tab} is-active`}
            data-filter={allKey}
            type="button"
          >
            Wszystkie
          </button>
          {tabs.map((tab) => (
            <button
              class={s.tab}
              data-filter={tab.key}
              type="button"
            >
              {tab.label}
            </button>
          ))}
        </div>
      )
    }

    <div class={s.grid} id="gallery-grid">
      {
        items.map((item, idx) => {
          return (
            <div class={s.item} data-tag={item.tag}>
              <button
                type="button"
                class="block w-full text-left"
                data-lightbox-open
                data-index={idx}
                data-src={item.image.src.src}
                data-alt={item.image.alt}
                data-caption={item.caption ?? item.image.alt}
              >
                <Image
                  src={item.image.src}
                  alt={item.image.alt}
                  class="w-full aspect-video object-cover hover:scale-[1.02] transition-transform duration-200"
                  widths={[360, 540, 720, 960, 1200]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  loading={idx < 6 ? 'eager' : 'lazy'}
                  decoding="async"
                  width={1200}
                  height={675}
                />
              </button>
            </div>
          )
        })
      }
    </div>
  </div>
</section>

<div
  id="gallery-lightbox"
  class="fixed inset-0 z-[120] hidden bg-black/85 p-4 sm:p-6"
  aria-hidden="true"
  role="dialog"
  aria-label="Podgląd zdjęcia"
>
  <div class="h-full w-full flex flex-col items-center justify-center gap-4">
    <button
      type="button"
      id="gallery-lightbox-close"
      class="self-end text-white/80 hover:text-white text-sm px-3 py-2 rounded-md bg-white/10"
    >
      Zamknij
    </button>
    <img
      id="gallery-lightbox-image"
      src={transparentPixel}
      alt=""
      class="max-h-[72vh] w-auto max-w-full object-contain rounded-lg shadow-2xl"
      loading="eager"
      decoding="async"
      width="1200"
      height="675"
    />
    <p
      id="gallery-lightbox-caption"
      class="max-w-4xl text-center text-white/90 text-sm sm:text-base leading-relaxed"
    >
    </p>
  </div>
</div>

<script>
  const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]')
  const lightbox = document.getElementById('gallery-lightbox')
  const closeButton = document.getElementById('gallery-lightbox-close')
  const lightboxImage = document.getElementById('gallery-lightbox-image') as HTMLImageElement | null
  const lightboxCaption = document.getElementById('gallery-lightbox-caption')
  let activeIndex = 0

  const updateLightbox = (index: number) => {
    const btn = openButtons[index]
    if (!btn || !lightboxImage || !lightboxCaption) return
    lightboxImage.src = btn.dataset.src ?? ''
    lightboxImage.alt = btn.dataset.alt ?? ''
    lightboxCaption.textContent = btn.dataset.caption ?? btn.dataset.alt ?? ''
    activeIndex = index
  }

  const openLightbox = (index: number) => {
    if (!lightbox) return
    updateLightbox(index)
    lightbox.classList.remove('hidden')
    lightbox.setAttribute('aria-hidden', 'false')
    document.body.style.overflow = 'hidden'
  }

  const closeLightbox = () => {
    if (!lightbox) return
    lightbox.classList.add('hidden')
    lightbox.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
  }

  const nextImage = () => {
    if (openButtons.length === 0) return
    const next = (activeIndex + 1) % openButtons.length
    updateLightbox(next)
  }

  const prevImage = () => {
    if (openButtons.length === 0) return
    const prev = (activeIndex - 1 + openButtons.length) % openButtons.length
    updateLightbox(prev)
  }

  openButtons.forEach((button, idx) => {
    button.addEventListener('click', () => openLightbox(idx))
  })

  closeButton?.addEventListener('click', closeLightbox)
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox()
  })

  document.addEventListener('keydown', (event) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return
    if (event.key === 'Escape') closeLightbox()
    if (event.key === 'ArrowRight') nextImage()
    if (event.key === 'ArrowLeft') prevImage()
  })

  const tabs = document.querySelectorAll<HTMLButtonElement>('#gallery-tabs [data-filter]')
  const items = document.querySelectorAll<HTMLElement>('#gallery-grid [data-tag]')

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter ?? 'all'

      tabs.forEach((t) => {
        t.classList.remove('is-active')
      })
      tab.classList.add('is-active')

      items.forEach((item) => {
        if (filter === 'all' || item.dataset.tag === filter) {
          item.style.display = ''
        } else {
          item.style.display = 'none'
        }
      })
    })
  })
</script>

<style>
  #gallery-tabs .ds-pill {
    background: var(--n-200);
    color: var(--text-primary);
    transition: background-color var(--dur-base) var(--ease-standard);
  }

  #gallery-tabs .ds-pill.is-active {
    background: var(--navy-700);
    color: white;
  }
</style>
