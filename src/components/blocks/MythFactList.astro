---
interface MythFactItem {
  myth: string
  fact: string
  href?: string
}

interface Props {
  style?: Record<string, string>
  title?: string
  items?: MythFactItem[]
}

const { style, title, items = [] } = Astro.props
const defaultStyle = {
  root: 'ds-section',
  inner: 'ds-container max-w-[980px]',
  list: 'grid gap-6 mt-2',
}
const s = { ...defaultStyle, ...(style ?? {}) }
---

<section class={s.root}>
  <div class={s.inner}>
    {title && <h2 class="ds-h2 mb-8">{title}</h2>}
    <ul class={s.list}>
      {
        items.map((item, index) => (
          <li class="ds-surface border border-[var(--border-default)] rounded-[var(--r-lg)] p-6 grid gap-4">
            <div class="grid gap-4 md:grid-cols-2">
              <div class="rounded-[var(--r-md)] border border-red-200 bg-red-50/70 p-4 flex items-start gap-3">
                <span class="shrink-0 mt-0.5 w-6 h-6 rounded-full bg-red-100 text-red-600 flex items-center justify-center text-xs font-bold">
                  ✗
                </span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-red-700 mb-1">
                    Mit {index + 1}
                  </p>
                  <p class="text-[var(--text-default)] text-sm">{item.myth}</p>
                </div>
              </div>
              <div class="rounded-[var(--r-md)] border border-emerald-200 bg-emerald-50/70 p-4 flex items-start gap-3">
                <span class="shrink-0 mt-0.5 w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold">
                  ✓
                </span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700 mb-1">
                    Fakt
                  </p>
                  <p class="text-[var(--text-strong)] text-sm">{item.fact}</p>
                </div>
              </div>
            </div>
            {item.href && (
              <a
                href={item.href}
                class="text-xs text-[var(--amber-600)] hover:text-[var(--amber-700)] transition-colors self-end"
              >
                Dowiedz się więcej →
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
