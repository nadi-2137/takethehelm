---
import { navigation } from '../../lib/navigation'

interface Props {
  style?: Record<string, string>
}

const { style } = Astro.props
const defaultStyle = {
  root: 'bg-[var(--navy-950)] text-white/70',
  inner: 'ds-container py-12 md:py-16',
  menu: 'flex gap-6 text-white/70',
  copy: 'text-white/50 text-sm',
}
const s = { ...defaultStyle, ...(style ?? {}) }
const columns = navigation.footer.columns
const copyright = navigation.footer.copyright
const author = navigation.footer.author
---

<footer class={s.root}>
  <div class={s.inner}>
    <!-- Brand + tagline -->
    <div class="flex items-center gap-3 mb-10">
      <img
        src="brand/logo.png"
        alt={`${navigation.brand.name} logo`}
        width="48"
        height="48"
        class="w-12 h-12 rounded-md object-contain"
        loading="lazy"
        decoding="async"
      />
      <div class="leading-none pt-0.5">
        <span class="text-white text-[18px] font-normal tracking-[0.05em] block leading-[1.05]">
          {navigation.brand.name}
        </span>
        <span
          class="text-white/70 text-[11px] font-light tracking-[0.02em] leading-[1.15] block mt-1"
        >
          {navigation.brand.tagline}
        </span>
      </div>
    </div>

    <!-- Columns grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 mb-10">
      {
        columns.map((col) => (
          <div>
            <p class="text-white/90 font-semibold text-[15px] mb-3">{col.title}</p>
            <ul class="list-none m-0 p-0 grid gap-1.5">
              {col.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-white/65 text-[15px] leading-6 hover:text-white transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Copyright -->
    <div class="border-t border-white/10 pt-6 grid gap-2">
      <p class="text-white/40 text-xs">{copyright}</p>
      <p class="text-white/50 text-xs">{author}</p>
    </div>
  </div>
</footer>
