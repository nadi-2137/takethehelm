---
import { type AppImage } from '@/lib/images'
import { Image } from 'astro:assets'

interface Props {
  style?: Record<string, string>
  title?: string
  subtitle?: string
  image?: AppImage
  action?: { label: string; href: string }
}

const { style, title = '', subtitle = '', image, action } = Astro.props
const defaultStyle = {
  root: 'ds-section',
  inner: 'ds-container grid grid-cols-1 lg:grid-cols-12 gap-8 items-center',
  copy: 'lg:col-span-5',
  media: 'lg:col-span-7',
  title: 'ds-h2 mb-3',
  subtitle: 'ds-muted mb-6',
}
const s = { ...defaultStyle, ...(style ?? {}) }
---

<section class={s.root}>
  <div class={s.inner}>
    <div class={s.copy}>
      <h2 class={s.title}>{title}</h2>
      {subtitle && <p class={s.subtitle}>{subtitle}</p>}
      {
        action && (
          <a href={action.href} class="ds-btn ds-btn-primary">
            {action.label}
          </a>
        )
      }
    </div>
    <div
      class={`${s.media} overflow-hidden rounded-[var(--r-xl)] bg-gradient-to-br from-[var(--navy-700)] to-[var(--navy-950)]`}
    >
      {image?.src && (
        <Image
          src={image.src}
          alt={image.alt}
          class="w-full h-full object-cover"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1280px) 660px, (min-width: 1024px) 58vw, 100vw"
        />
      )}
    </div>
  </div>
</section>
