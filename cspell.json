{
  "version": "0.2",
  "language": "pl,en",
  "import": [
    "@cspell/dict-pl_pl/cspell-ext.json"
  ],
  "files": [
    "src/**/*.{ts,astro}",
    "content/**/*.json"
  ],
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    "public/**",
    "design/**",
    ".astro/**",
    "*.config.*",
    "content/old-pages/**"
  ],
  "overrides": [
    {
      "filename": [
        "content/**/*.json"
      ],
      "locale": "pl,pl_PL"
    }
  ],
  "ignoreRegExpList": [
    "#[0-9a-fA-F]{3,8}",
    "var\\(--[\\w-]+\\)",
    "/images/[\\w./_-]+",
    "\"[/][\\w/_-]+\"",
    "#[a-z][a-z_-]+",
    "U\\+[0-9A-F]{4}"
  ],
